# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/monopoly_world
# Or for SQLite (MVP):
# DATABASE_TYPE=sqlite
# DATABASE_PATH=./data/database.sqlite

# Discord Channel IDs
CHANNEL_ANNOUNCEMENTS=channel_id_for_announcements
CHANNEL_HIGHLIGHTS=channel_id_for_shipped_highlights
CHANNEL_ADMIN_LOGS=channel_id_for_admin_logs

# Google Sheets API (for survey ingestion)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_RANGE=Sheet1!A:Z
GOOGLE_SERVICE_ACCOUNT_KEY=path_to_service_account_json_or_base64_encoded
# Structured Report Build Spreadsheets (format: "version:spreadsheet_id,version:spreadsheet_id,...")
# Each build has its own spreadsheet. These are synced hourly along with the main spreadsheet.
# Example: 2.10:spreadsheet_id_here,2.11:spreadsheet_id_here,...
GOOGLE_SHEETS_STRUCTURED_REPORT_BUILDS=2.10:PLACEHOLDER,2.11:PLACEHOLDER,2.12:PLACEHOLDER,2.13:PLACEHOLDER,2.14:PLACEHOLDER,2.15:PLACEHOLDER,2.16:PLACEHOLDER,2.17:PLACEHOLDER
# Record your session spreadsheet
GOOGLE_SHEETS_RECORD_SESSION_SPREADSHEET_ID=PLACEHOLDER

# Program Configuration
PROGRAM_ROLES=Tester Recruit,Explorer,Test Pilot,Founders Circle

# Rate Limiting
RATE_LIMIT_SUBMIT_PER_HOUR=10

# Build - max TC per user per build (normal submissions; delivered features exempt)
BUILD_MAX_TC_PER_USER=200

# TC Scoring (can be overridden)
TC_QUICK_TEST=10
TC_SURVEY=3
TC_SCREENSHOT=5
TC_BUG_REPRO=25
TC_BUG_VIDEO=40
TC_BALANCE_ANALYSIS=30
TC_RETEST=15
TC_SHIPPED_BONUS=100

# Rank Thresholds
RANK_EXPLORER_TC=60
RANK_TEST_PILOT_TC=250
RANK_TEST_PILOT_STRUCTURED=2
RANK_FOUNDERS_CIRCLE_TC=900
RANK_FOUNDERS_CIRCLE_TOP_N=15

# Form Links (for /participate command)
FORM_SCREENSHOT=https://forms.gle/PuV2VpfLBixRhKS87
FORM_BUG_REPRO=https://forms.gle/PuV2VpfLBixRhKS87
FORM_BUG_VIDEO=https://forms.gle/PuV2VpfLBixRhKS87
FORM_BALANCE_ANALYSIS=https://forms.gle/PuV2VpfLBixRhKS87
FORM_RETEST=https://forms.gle/PuV2VpfLBixRhKS87
FORM_RECORD_SESSION=https://forms.gle/5MX1yoNdJxLfrGTS8
FORM_STRUCTURED_REPORT=https://forms.gle/PuV2VpfLBixRhKS87
# Structured Report links (comma-separated, rotates every 8 weeks based on week number in year)
FORM_STRUCTURED_REPORT_LINKS=https://forms.gle/PuV2VpfLBixRhKS87
# Structured Report Build Forms (format: "version:form_url,version:form_url,...")
# Each build has its own form. Provide Google Forms URLs (not spreadsheet URLs).
# Example: 2.10:https://forms.gle/...,2.11:https://forms.gle/...
FORM_STRUCTURED_REPORT_BUILDS=2.10:https://forms.gle/PLACEHOLDER,2.11:https://forms.gle/PLACEHOLDER,2.12:https://forms.gle/PLACEHOLDER,2.13:https://forms.gle/PLACEHOLDER,2.14:https://forms.gle/PLACEHOLDER,2.15:https://forms.gle/PLACEHOLDER,2.16:https://forms.gle/PLACEHOLDER,2.17:https://forms.gle/PLACEHOLDER
